{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "next-dev",
      "runtimeExecutable": "/opt/homebrew/bin/node",
      "runtimeArgs": ["node_modules/.bin/next", "dev", "--hostname", "0.0.0.0"],
      "port": 3005,
      "autoPort": true,
      "env": {
        "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin",
        "NEXT_PUBLIC_SANITY_PROJECT_ID": "xjjjqhgt",
        "NEXT_PUBLIC_SANITY_DATASET": "production"
      }
    },
    {
      "name": "design-preview",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "7788", "--directory", ".claude/drafts/landing-redesign"],
      "port": 7788
    },
    {
      "name": "usvc-preview",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "7799", "--directory", ".claude/design/usvc-round"],
      "port": 7799
    }
  ]
}
