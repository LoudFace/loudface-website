# Sanity CMS Configuration
# Copy this file to .env and fill in your values
# On Vercel, set these in Settings → Environment Variables

# Sanity Project ID and Dataset
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API Token (for write operations / migration)
# Get from: https://www.sanity.io/manage → API → Tokens
SANITY_API_TOKEN=your_token_here

# ─── Gated client proposals (loudface.co/p/<token>) ───────────────────────
# These read the PRIVATE `proposals` dataset. The `production` dataset is
# public — anything in it is readable by anyone with the project ID — so
# proposal pricing must never be stored there. Full setup: docs/PROPOSALS.md

# Read token for the private proposals dataset.
# https://www.sanity.io/manage → API → Tokens → Add token → Viewer
# Without it every /p/ URL returns 404.
SANITY_PROPOSALS_TOKEN=your_proposals_read_token_here

# Optional. Only set this to point the proposal pages at a different dataset.
# SANITY_PROPOSALS_DATASET=proposals

# Signs the httpOnly cookie that remembers "this browser entered the right
# access code". Generate with: openssl rand -hex 32
# If unset, a random per-process secret is used and readers are re-challenged
# after every restart or deploy. Never insecure, just annoying.
PROPOSAL_COOKIE_SECRET=your_random_32_byte_hex_here

# PostHog Analytics
# Get this from: PostHog Dashboard → Project Settings → Project API Key
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Meta Pixel (client-side, consent-gated)
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id_here

# Meta Conversions API (server-side)
META_PIXEL_ID=your_meta_pixel_id_here
META_CAPI_ACCESS_TOKEN=your_meta_capi_access_token_here

# Cal.com Webhook
# Shared secret used to verify webhook signatures from Cal.com
# Generate with: openssl rand -hex 32
# Register webhook at: https://app.cal.com/settings/developer/webhooks
#   URL: https://<your-domain>/api/webhooks/cal
#   Triggers: BOOKING_CREATED, BOOKING_RESCHEDULED, BOOKING_CANCELLED
CAL_WEBHOOK_SECRET=your_cal_webhook_secret_here

# DataForSEO API (AI Visibility Audit)
# Get credentials from: https://app.dataforseo.com/
DATAFORSEO_LOGIN=your_login_here
DATAFORSEO_PASSWORD=your_password_here

# Vercel AI Gateway (AI Visibility Audit — Phase 1 structured extraction)
# Used by src/lib/audit/extract-structured.ts via the Vercel AI SDK (model routing).
# Get from: https://vercel.com/dashboard → AI → Gateway → API Keys
AI_GATEWAY_API_KEY=your_gateway_key_here

# Google PageSpeed Insights API Key (for pagespeed-audit script)
# Get from: Google Cloud Console → APIs & Services → Credentials → Create API Key
# Enable "PageSpeed Insights API" first. Free: 25,000 queries/day with key.
PAGESPEED_API_KEY=

# Redis (for audit result storage)
# Auto-populated by Vercel Storage integration
REDIS_URL=
